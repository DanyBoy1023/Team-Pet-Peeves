[connection signal="all_dishes_clean" from="Dish Clean Controller" to="Roomate Controller" method="_on_dish_clean_controller_all_dishes_clean"]
[connection signal="all_dishes_clean" from="Dish Clean Controller" to="Roomate Controller/AnimatedSprite2D" method="play" binds= ["end"]]
[connection signal="all_dishes_clean" from="Dish Clean Controller" to="Dishwasher/AnimationPlayer" method="play" binds= ["get out of here"]]
[connection signal="mouse_entered" from="Sponge Holding Spot/Sponge" to="Sponge Holding Spot/Sponge" method="_on_mouse_entered"]
[connection signal="mouse_exited" from="Sponge Holding Spot/Sponge" to="Sponge Holding Spot/Sponge" method="_on_mouse_exited"]
[connection signal="timeout" from="Roomate Controller/Timer" to="Roomate Controller" method="_on_timer_timeout"]
